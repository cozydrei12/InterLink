@using InterLink.Models
@inject Store S
@{
    ViewData["Title"] = "Change password";
    var me = S.U(int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value))!;
}
<div class="row justify-content-center">
    <div class="col-md-7">
        <h3 class="mb-3">Account Security</h3>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="card mb-4">
            <div class="card-header">Change Password</div>
            <form method="post" asp-action="ChangePassword" class="card-body">
                <label class="form-label">Current password</label>
                <input class="form-control mb-3" type="password" name="currentPassword" required />
                <label class="form-label">New password (at least 6 characters)</label>
                <input class="form-control mb-3" type="password" name="newPassword" required />
                <label class="form-label">Confirm new password</label>
                <input class="form-control mb-3" type="password" name="confirmPassword" required />
                <button class="btn btn-primary">Update password</button>
            </form>
        </div>

        <div class="card mb-4">
            <div class="card-header">Recovery Question</div>
            <form method="post" asp-action="UpdateSecurity" class="card-body">
                <p class="text-muted">Current question: <strong>@(me.Question == "" ? "Not set" : me.Question)</strong></p>
                <label class="form-label">New security question</label>
                <select name="question" class="form-select mb-3">
                    @foreach (var q in Store.Questions)
                    {
                        <option>@q</option>
                    }
                </select>
                <label class="form-label">Your answer</label>
                <input class="form-control mb-3" name="answer" required />
                <label class="form-label">Current password (to confirm)</label>
                <input class="form-control mb-3" type="password" name="currentPassword" required />
                <button class="btn btn-primary">Save recovery question</button>
            </form>
        </div>
        <a href="/" class="btn btn-outline-secondary">Back to dashboard</a>
    </div>
</div>