@{
    ViewData["Title"] = "Forgot password";
    var question = (string?)ViewBag.Question;
    var uname = (string?)ViewBag.Username;
}

<style>
    .il-brand {
        background: linear-gradient(160deg, #0f2742 0%, #1d4e89 100%);
        color: #fff;
    }

    .il-mark {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #fff;
        color: #1d4e89;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-size: 1.15rem;
    }

    .il-form-wrap {
        max-width: 420px;
        width: 100%;
    }

        .il-form-wrap .form-control:focus {
            border-color: #1d4e89;
            box-shadow: 0 0 0 .2rem rgba(29,78,137,.2);
        }

    .il-btn {
        --bs-btn-bg: #1d4e89;
        --bs-btn-border-color: #1d4e89;
        --bs-btn-hover-bg: #163d6c;
        --bs-btn-hover-border-color: #163d6c;
        --bs-btn-active-bg: #12335a;
        --bs-btn-active-border-color: #12335a;
        --bs-btn-color: #fff;
        --bs-btn-hover-color: #fff;
        --bs-btn-active-color: #fff;
    }

    .il-account {
        display: flex;
        align-items: center;
        gap: .75rem;
        background: #f1f4f8;
        border-radius: .75rem;
        padding: .75rem 1rem;
    }

    .il-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #1d4e89;
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 600;
        flex: none;
    }

    @@media (max-width: 991.98px) {
        .il-brand {
            padding: 2rem 1.5rem !important;
        }
    }
</style>

<div class="container-fluid p-0">
    <div class="row g-0 min-vh-100">

        <!-- Brand panel -->
        <div class="col-lg-5 il-brand d-flex flex-column justify-content-center p-5">
            <div class="mx-auto" style="max-width: 420px;">
                <div class="il-mark mb-4">IL</div>
                <h1 class="display-5 fw-bold mb-2">Reset password</h1>
                <p class="fs-5 mb-0" style="color: rgba(255,255,255,.8);">
                    Answer your security question to set a new password.
                </p>
            </div>
        </div>

        <!-- Form panel -->
        <div class="col-lg-7 d-flex align-items-center justify-content-center bg-light p-4 p-md-5">
            <div class="il-form-wrap">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5">

                        <h2 class="fw-bold mb-1">Forgot password?</h2>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger py-2 mt-3" role="alert">@ViewBag.Error</div>
                        }

                        @if (question == null)
                        {
                            <p class="text-muted mb-4">Enter your username to find your security question.</p>

                            <form method="post" asp-action="ForgotPassword">
                                <div class="mb-4">
                                    <label for="username" class="form-label fw-semibold">Username</label>
                                    <input id="username" name="username" class="form-control form-control-lg"
                                           autocomplete="username" autofocus required />
                                </div>
                                <button type="submit" class="btn il-btn btn-lg w-100">Continue</button>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted mb-3">Answer your security question, then choose a new password.</p>

                            <div class="il-account mb-4">
                                <div class="il-avatar">@(string.IsNullOrEmpty(uname) ? "?" : uname.Substring(0, 1).ToUpper())</div>
                                <div>
                                    <div class="small text-muted">Account</div>
                                    <div class="fw-semibold">@uname</div>
                                </div>
                            </div>

                            <form method="post" asp-action="ResetPassword" id="resetForm">
                                <input type="hidden" name="username" value="@uname" />

                                <div class="mb-3">
                                    <label for="answer" class="form-label fw-semibold">@question</label>
                                    <input id="answer" name="answer" class="form-control form-control-lg"
                                           autocomplete="off" autofocus required />
                                </div>

                                <div class="mb-3">
                                    <label for="newPassword" class="form-label fw-semibold">New password</label>
                                    <input id="newPassword" name="newPassword" type="password"
                                           class="form-control form-control-lg" minlength="6"
                                           autocomplete="new-password" required />
                                    <div class="form-text">At least 6 characters.</div>
                                </div>

                                <div class="mb-4">
                                    <label for="confirmPassword" class="form-label fw-semibold">Confirm new password</label>
                                    <input id="confirmPassword" name="confirmPassword" type="password"
                                           class="form-control form-control-lg"
                                           autocomplete="new-password" required />
                                    <div class="invalid-feedback">Passwords do not match.</div>
                                </div>

                                <button type="submit" class="btn il-btn btn-lg w-100">Reset password</button>
                            </form>
                        }

                        <p class="text-center mt-4 mb-0">
                            <a asp-action="Login" class="fw-semibold text-decoration-none">Back to login</a>
                        </p>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@if (question != null)
{
    <script>
        var form = document.getElementById('resetForm');
        var np = document.getElementById('newPassword');
        var cp = document.getElementById('confirmPassword');

        form.addEventListener('submit', function (e) {
            if (np.value !== cp.value) {
                e.preventDefault();
                cp.classList.add('is-invalid');
                cp.focus();
            }
        });
        cp.addEventListener('input', function () {
            cp.classList.remove('is-invalid');
        });
    </script>
}